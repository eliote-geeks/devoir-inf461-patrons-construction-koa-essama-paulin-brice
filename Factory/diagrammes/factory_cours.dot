digraph FactoryCours {
  graph [rankdir=TB, pad="0.25", nodesep="0.35", ranksep="0.5", bgcolor="white"];
  node [shape=plain, fontname="Arial"];
  Client [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td><b>Client</b></td></tr><tr><td>+ main()</td></tr></table>>];
  Factory [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td>&lt;&lt;abstract&gt;&gt;<br/><b>ProduitFactory</b></td></tr><tr><td align="left">+ getProduit(): Produit<br/># createProduit(): Produit</td></tr></table>>];
  Produit [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td>&lt;&lt;interface&gt;&gt;<br/><b>Produit</b></td></tr><tr><td>+ methodeProduit()</td></tr></table>>];
  FA [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td><b>ProduitFactoryA</b></td></tr><tr><td># createProduit()</td></tr></table>>]; FB [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td><b>ProduitFactoryB</b></td></tr><tr><td># createProduit()</td></tr></table>>]; FC [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td><b>ProduitFactoryC</b></td></tr><tr><td># createProduit()</td></tr></table>>];
  A [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td><b>ProduitA</b></td></tr><tr><td>+ methodeProduit()</td></tr></table>>]; B [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td><b>ProduitB</b></td></tr><tr><td>+ methodeProduit()</td></tr></table>>]; C [label=<<table border="1" cellborder="0" cellspacing="0"><tr><td><b>ProduitC</b></td></tr><tr><td>+ methodeProduit()</td></tr></table>>];
  {rank=same; Client; Factory; Produit} {rank=same; FA; FB; FC} {rank=same; A; B; C}
  Client -> Factory [style=dashed]; Client -> Produit [style=dashed]; FA -> Factory [arrowhead=empty]; FB -> Factory [arrowhead=empty]; FC -> Factory [arrowhead=empty]; A -> Produit [arrowhead=empty]; B -> Produit [arrowhead=empty]; C -> Produit [arrowhead=empty]; FA -> A [style=dashed, label="crée"]; FB -> B [style=dashed, label="crée"]; FC -> C [style=dashed, label="crée"];
}
